# Server context: no demo JSON, LFS sources, publication or tooling caches.
demo
.pages
.pages-probe
.media-cache
.tools
.task
docs
tasks
Taskfile.yaml
test-results
playwright-report
tests

# Keep modules referenced by Vite even for API typechecking.
scripts/*
!scripts/demo-media-plugin.mjs
!scripts/demo-media-plugin.d.mts
!scripts/static-server.mjs
!scripts/assert-release.mjs

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist
dist-ssr
*.local

# Environment variables
.env*
!.env.example

# Git
.git
.gitignore
.gitattributes

# Version control
.svn
.hg

# IDE and editors
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln

# eslint.config.ts is needed by tsconfig.node.json and must remain in context.
.eslintrc.*
.eslintignore

# Testing
coverage
.nyc_output
# Tests importing demo fixtures are checked on the host/CI, outside the server context.
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
**/__tests__
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__
__mocks__

# Documentation
README.md
*.md
Documentation

# CI/CD
.github
.gitlab-ci.yml
.travis.yml
.circleci

# Docker
Dockerfile*
.dockerignore
docker-compose*.yml

# Misc
*.log
logs
.cache
.temp
tmp

