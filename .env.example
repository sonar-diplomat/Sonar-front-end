# API Base URL Configuration
# Copy this file to .env.local and update with your local values

# Local development - use your local backend URL
# For local dev, you can also use the proxy from vite.config.ts by setting this to '/api/'
VITE_API_BASE_URL=http://localhost:5205/api/

# Proxy target for Vite dev server (only used when VITE_API_BASE_URL='/api/')
# This is the base URL of your backend without the /api/ suffix
VITE_PROXY_TARGET=http://localhost:5205

# Production/Remote - set this in GitHub Secrets as VITE_API_BASE_URL
# Example: VITE_API_BASE_URL=https://your-remote-api.com/api/
